<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS URL Rewrite rules for the Altanon HRMS site on the Windows/IIS VPS
  (same VPS + pattern as LeadSignal's deploy/web.config).

  Unlike LeadSignal, there's no separate static frontend/dist — Next.js
  serves everything itself (pages, API routes, static assets) from one
  process, so this just reverse-proxies the whole host to that process.

  Install: place this file at the IIS site's physical path root, e.g.
    C:\Repos\hrms\deploy-web.config -> copy to C:\Repos\hrms\web.config
  (or point the IIS site's physical path directly at the repo root and
  this file next to it — see deploy/README.md).

  Requires the IIS "Application Request Routing" (ARR) and "URL Rewrite"
  modules — already installed on this VPS for the LeadSignal site.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTPS Redirect" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://hrms.altanontech.com/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to Next.js" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:1}" />
          <!--
            Without these, ARR forwards X-Forwarded-Host as the upstream
            target (127.0.0.1:3001) instead of the real hostname, which
            fails Next.js's Server Actions same-origin check (Origin:
            hrms.altanontech.com vs x-forwarded-host: 127.0.0.1:3001) and
            every server action 500s. Requires HTTP_X_FORWARDED_HOST and
            HTTP_X_FORWARDED_PROTO to be allowed server variables (see
            deploy/README.md).
          -->
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
